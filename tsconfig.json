{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["framework/**/*.ts", "section-a/**/*.ts", "section-b/**/*.ts", "self-healing/**/*.ts", "sql/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["section-a/app/src", "section-a/app/vite.config.ts", "section-a/app/dist"]
}
