# Local run profile (TEST_ENV=local). Copy to .env.local.local to override privately.
WEB_PORT=5055
# WEB_BASE_URL defaults to http://localhost:$WEB_PORT. Set it only to test a copy running somewhere else.
APP_AUTOSTART=true

JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com

BROWSER=chromium
BROWSER_CHANNEL=
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
DEFAULT_TIMEOUT_MS=15000
STEP_TIMEOUT_MS=60000
TRACE=retain-on-failure
SCREENSHOTS=on-failure

SELF_HEAL=off
HEAL_PROVIDER=auto
