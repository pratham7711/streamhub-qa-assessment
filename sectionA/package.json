{
  "name": "streamhub-qa-section-a",
  "version": "1.0.0",
  "private": true,
  "description": "Streamhub QA assessment, Section A: the LoanLens web app on its own mock data, its Playwright + Cucumber UI suite, the JSONPlaceholder API suite, SQL, and an AI self-healing locator POC",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "start": "tsx app/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "test": "node scripts/run-all.mjs",
    "test:loanlens-ui": "node scripts/run-suite.mjs loanlens-ui",
    "test:jsonplaceholder": "node scripts/run-suite.mjs jsonplaceholder",
    "data:generate": "tsx scripts/generate-loans.ts",
    "test:sql": "node scripts/run-suite.mjs sql",
    "test:self-healing": "node scripts/run-suite.mjs self-healing",
    "test:mutation": "node scripts/mutation-check.mjs",
    "heal": "tsx self-healing/cli.ts",
    "sql:render": "tsx sql/scripts/render-results.ts",
    "sql:seed": "tsx sql/scripts/build-ipl-seed.ts",
    "heal:eval": "tsx self-healing/eval.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@cucumber/cucumber": "^13.3.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
