# Run profile for TEST_ENV=local (the default). Real environment variables override these values.
# The web app under test. npm test starts it on this port when it is a localhost URL and nothing answers there.
WEB_BASE_URL=http://localhost:5055
JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com

HEADLESS=true
DEFAULT_TIMEOUT_MS=15000
STEP_TIMEOUT_MS=60000
