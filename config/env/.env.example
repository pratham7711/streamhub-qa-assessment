# Local run profile (TEST_ENV=local). Copy to .env.local.local to override privately.
# Section A's web app and Section B's API are separate servers on separate ports.
WEB_PORT=5055
API_PORT=5056
# WEB_BASE_URL and API_BASE_URL default to http://localhost:$WEB_PORT and http://localhost:$API_PORT/api.
# Set them only to test a copy running somewhere else.
APP_AUTOSTART=true

JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com
EMI_CALCULATOR_URL=https://emicalculator.net/

BROWSER=chromium
BROWSER_CHANNEL=
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
DEFAULT_TIMEOUT_MS=15000
STEP_TIMEOUT_MS=60000
TRACE=retain-on-failure
SCREENSHOTS=on-failure

SELF_HEAL=off
HEAL_PROVIDER=auto
