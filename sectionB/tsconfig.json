{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "framework/**/*.ts",
    "api/**/*.ts",
    "loanlens-api/**/*.ts",
    "emicalculator/**/*.ts",
    "self-healing/**/*.ts",
    "sql/**/*.ts",
    "scripts/**/*.ts"
  ]
}
